# Stripe Configuration
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Webhook URL (production endpoint — where Stripe delivers events)
STRIPE_WEBHOOK_URL=https://yourdomain.com/api/webhooks/stripe

# Stripe Webhook Secret
# Local dev: run `npm run stripe:listen` (stripe listen --forward-to localhost:3000/api/webhooks/stripe)
# and copy the printed whsec_... value here.
# Production: create an endpoint pointing at the STRIPE_WEBHOOK_URL above
# in the Stripe dashboard and use its whsec_... value.
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase Configuration
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Email Configuration (Optional - uses Resend)
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=re_...

# Email address where order notifications are sent
ORDER_NOTIFICATION_EMAIL=orders@yourdomain.com

# Verified sender email for order confirmations
# Defaults to onboarding@resend.dev (test only - verify your domain for production)
RESEND_FROM_EMAIL=noreply@yourdomain.com
